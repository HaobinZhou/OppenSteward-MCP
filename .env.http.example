# Copy to .env for a deployment behind your own HTTPS reverse proxy.
OPPEN_TRANSPORT=http
OPPEN_PUBLIC_URL=https://projects.example.com
OPPEN_HOST=127.0.0.1
OPPEN_PORT=8766
OPPEN_PROJECTS_FILE=projects.local.json
OPPEN_EXCLUDE_ROOTS=[]
# off / read / write. HTTP clients must separately authorize Discussion scopes.
OPPEN_DISCUSSION_MODE=off
OPPEN_STATE_DIR=.runtime
OPPEN_SKILL_ROOT=
OPPEN_EXTRA_REDIRECT_URIS=[]
# setup creates the owner login passphrase locally. Do not put it in this file.
