# Default: local stdio, launched through OpenAI Secure MCP Tunnel.
# Copy to .env. Arrays are JSON; use forward slashes in Windows paths.
OPPEN_TRANSPORT=stdio
OPPEN_SCAN_ROOTS=["~"]
OPPEN_EXCLUDE_ROOTS=[]
OPPEN_STATE_DIR=.runtime
# Optional parent of oppen-project-steward/ and stepwise-r-project/.
OPPEN_SKILL_ROOT=
OPPEN_SCAN_INTERVAL=300
OPPEN_SCAN_SECONDS=90
OPPEN_MAX_SCAN_DIRS=500000

OPPEN_TUNNEL_ID=tunnel_REPLACE_WITH_YOUR_32_HEX_ID
OPPEN_TUNNEL_PROFILE=oppen-steward
# Or an absolute path to tunnel-client / tunnel-client.exe.
OPPEN_TUNNEL_CLIENT=tunnel-client
# Runtime API key, not an admin key. Never commit the filled .env.
CONTROL_PLANE_API_KEY=
